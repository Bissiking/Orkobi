# Copier vers .env à la racine. Aucune valeur secrète requise pour ce lot.
NODE_ENV=development
CORE_HOST=127.0.0.1
CORE_PORT=3001
# Documentation interne désactivée par défaut ; activer uniquement en réseau de confiance.
CORE_OPENAPI_ENABLED=false

# Navigateur → BFF (même origine) → Core (cette URL reste côté serveur).
BFF_HOST=127.0.0.1
BFF_PORT=3000
CORE_URL=http://127.0.0.1:3001
CORE_TIMEOUT_MS=2000
WEB_PORT=5173
