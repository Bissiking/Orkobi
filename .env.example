# pnpm infra:init crée .env avec des secrets locaux aléatoires sans écraser un fichier existant.
NODE_ENV=development
CORE_HOST=127.0.0.1
CORE_PORT=3001
# Documentation interne désactivée par défaut ; activer uniquement en réseau de confiance.
CORE_OPENAPI_ENABLED=false

# Navigateur → BFF (même origine) → Core (cette URL reste côté serveur).
BFF_HOST=127.0.0.1
BFF_PORT=3000
CORE_URL=http://127.0.0.1:3001
CORE_TIMEOUT_MS=2000
WEB_PORT=5173

# Hors Docker, SQL reste facultatif pour travailler sur le shell HTTP.
# Pour Core + PostgreSQL local : DB_ENABLED=true et compose.dev.yaml (guide infrastructure).
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=orkobi
DB_USER=orkobi_app
DB_PASSWORD=
MIGRATION_DB_USER=orkobi_migrator
MIGRATION_DB_PASSWORD=
POSTGRES_PASSWORD=
# Compose expose uniquement le BFF sur loopback ; Core et PostgreSQL restent internes.
BFF_PUBLISHED_PORT=3000
