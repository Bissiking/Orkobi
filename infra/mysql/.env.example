# Générer avec pnpm infra:init --engine=mariadb (ou --engine=mysql).
DB_ENGINE=mariadb
SQL_IMAGE=mariadb:11.4
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=orkobi
DB_USER=orkobi_app
DB_PASSWORD=
MIGRATION_DB_USER=orkobi_migrator
MIGRATION_DB_PASSWORD=
SQL_ROOT_PASSWORD=
BFF_PUBLISHED_PORT=3000
SETUP_TOKEN=
INTERNAL_TOKEN=
SESSION_SECURE=false
PUBLIC_ORIGIN=
REDIS_URL=
JOBS_ENABLED=true
JOBS_POLL_MS=1000
